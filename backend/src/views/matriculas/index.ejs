<%- include('../layouts/base') %>

<div class="container">

    <h2 class="titulo">Gerenciamento de Matrículas</h2>

    <a href="/matriculas/new" class="btn btn-primary">Nova Matrícula</a>

    <table class="tabela">
        <thead>
            <tr>
                <th>ID</th>
                <th>Aluno</th>
                <th>Turma</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            <% matriculas.forEach(m => { %>
            <tr>
                <td><%= m.id_matricula %></td>
                <td><%= m.nome_aluno %></td>
                <td><%= m.nome_turma %></td>
                <td><%= m.status %></td>

                <td>
                    <a href="/matriculas/<%= m.id_matricula %>/edit" class="acao editar">Editar</a>

                    <% if (user && user.role === "admin") { %>
                        |
                        <a href="/matriculas/<%= m.id_matricula %>/delete"
                           class="acao excluir"
                           onclick="return confirm('Excluir matrícula?')">
                            Excluir
                        </a>
                    <% } %>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<style>
    body {
        background-color: gray;
        font-family: Arial, Helvetica, sans-serif;
    }

    .container {
        max-width: 900px;
        margin: 20px auto;
        padding: 20px;
        background-color: white;
        border-radius: 10px;
    }

    .titulo {
        margin-bottom: 20px;
        color: #128847;
        text-align: center;
    }

    .btn-primary {
        background-color: #4287f5;
        padding: 10px 14px;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
    }

    .btn-primary:hover {
        background-color: #2f6ee9;
    }

    .tabela {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 16px;
    }

    .tabela th {
        background-color: #0c5e38; 
        color: white;
        padding: 12px;
        text-align: left;
    }

    .tabela td {
        border: 1px solid #ccc;
        padding: 10px;
    }

    .tabela tr:nth-child(even) {
        background-color: #f0f0f0;
    }

    .acao.editar {
        color: white;
        background-color: #007BFF;
        padding: 5px 10px;
        border-radius: 5px;
        font-weight: bold;
        text-decoration: none;
    }

    .acao.editar:hover {
        background-color: #005fcc;
    }

    .acao.excluir {
        color: white;
        background-color: #d62424;
        padding: 5px 10px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }

    .acao.excluir:hover {
        background-color: #b30000;
    }
</style>
