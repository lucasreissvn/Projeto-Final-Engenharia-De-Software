<%- include('../layouts/base') %>

<style>
    body {
        background: #f0f0f0;
        font-family: Arial, sans-serif;
    }

    .card {
        width: 450px;
        margin: 40px auto;
        background-image: linear-gradient(#128847, #15F673);
        padding: 25px;
        border-radius: 10px;
        color: #fff;
        box-shadow: 0px 0px 15px rgba(0,0,0,0.3);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #fff;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
    }

    select {
        width: 100%;
        padding: 8px;
        border-radius: 5px;
        border: none;
        margin-bottom: 15px;
    }

    button {
        width: 100%;
        background: #0c5c31;
        padding: 10px;
        border: none;
        border-radius: 5px;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        font-weight: bold;
    }

    button:hover {
        background: #093f23;
    }
</style>


<div class="card">
    <h2>Nova Matrícula</h2>

    <form action="/matriculas/new" method="POST">

        <label>Aluno:</label>
        <select name="id_aluno" required>
            <option value="">Selecione...</option>
            <% alunos.forEach(a => { %>
                <option value="<%= a.id_aluno %>"><%= a.nome %></option>
            <% }) %>
        </select>

        <label>Turma:</label>
        <select name="id_turma" required>
            <option value="">Selecione...</option>
            <% turmas.forEach(t => { %>
                <option value="<%= t.id_turma %>"><%= t.nome_turma %></option>
            <% }) %>
        </select>

        <label>Status:</label>
        <select name="status" required>
            <option value="ativada">Ativada</option>
            <option value="trancada">Trancada</option>
        </select>

        <button type="submit">Salvar</button>
    </form>
</div>
