<%- include('layouts/base') %>

<div class="dashboard-container">

    <h2 class="dash-title">Área do Sistema</h2>
    <p class="dash-welcome">Bem-vindo, <strong><%= user.nome %></strong>!</p>

    <div class="dash-cards">

        <a href="/cursos" class="dash-card">
            <h3>Cursos</h3>
            <p>Gerenciar cursos cadastrados</p>
        </a>

        <a href="/matriculas" class="dash-card">
            <h3>Matrículas</h3>
            <p>Gerenciar matrículas dos alunos</p>
        </a>

    </div>
</div>

<style>
    body {
        background: #e0e0e0 !important;
        font-family: Arial, Helvetica, sans-serif;
    }

    .dashboard-container {
        max-width: 900px;
        margin: 40px auto;
        padding: 20px;
        text-align: center;
    }

    .dash-title {
        font-size: 28px;
        margin-bottom: 5px;
        color: #0a2e1c;
    }

    .dash-welcome {
        color: #333;
        margin-bottom: 30px;
        font-size: 18px;
    }

    .dash-cards {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .dash-card {
        background-image: linear-gradient(135deg, #128847, #15F673);
        padding: 25px;
        border-radius: 12px;
        width: 260px;
        text-decoration: none;
        color: #fff;
        transition: 0.2s;
        text-align: left;
        box-shadow: 0 4px 10px rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .dash-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 14px rgba(0,0,0,0.3);
        filter: brightness(1.05);
    }

    .dash-card h3 {
        margin-top: 0;
        font-size: 22px;
        color: #fff;
    }

    .dash-card p {
        color: #e8ffe8;
        margin-top: 5px;
        font-size: 14px;
    }
</style>
